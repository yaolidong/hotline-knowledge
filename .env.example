# 复制为 .env 后配置。未设置令牌时所有业务接口拒绝访问。
HOTLINE_DATA_DIR=data
# 每个令牌至少 24 位，必须唯一；通过 hotline init 生成，不要使用示例密码。
HOTLINE_USERS={}
HOTLINE_LLM_BACKEND=kag
# 可选：已发布范围内的本地语义召回。未配置时继续使用图谱和关键词。
HOTLINE_EMBEDDING_BASE_URL=
HOTLINE_DEFAULT_KNOWLEDGE_SPACE=production
HOTLINE_EMBEDDING_MODEL=
HOTLINE_EMBEDDING_API_KEY=
HOTLINE_LLM_BASE_URL=
HOTLINE_LLM_MODEL=
# 本地 Ollama 示例（非默认启用；需先启动 deploy/compose.llm.yml --profile ollama）：
# HOTLINE_LLM_BACKEND=openai
# HOTLINE_LLM_BASE_URL=http://127.0.0.1:11434/v1
# HOTLINE_LLM_MODEL=qwen2.5:7b-instruct
# 本地 vLLM 示例（--profile vllm）：
# HOTLINE_LLM_BASE_URL=http://127.0.0.1:8000/v1
HOTLINE_LLM_API_KEY=
HOTLINE_LLM_TIMEOUT=90
HOTLINE_LLM_RETRIES=2
HOTLINE_EXTRACTION_VALIDATION_RETRIES=1
HOTLINE_LLM_CONCURRENCY=2
HOTLINE_LLM_MAX_TOKENS=12000
# 直接兼容客户端的厂商扩展参数，例如 DeepSeek 可使用 {"thinking":{"type":"disabled"}}。
HOTLINE_LLM_EXTRA_BODY={}
# AI 证据问答最多传入的原文字符数；超过时要求缩小范围，不静默截断条件。
HOTLINE_QA_CONTEXT_CHARS=30000
HOTLINE_QA_VALIDATION_RETRIES=1
# 默认不继承主机 HTTP_PROXY，避免本地/内网请求被错误转发。
HOTLINE_HTTP_TRUST_ENV=false
HOTLINE_OPENSPG_URL=http://127.0.0.1:8887
HOTLINE_OPENSPG_PROJECT_ID=0
HOTLINE_OPENSPG_TOKEN=
# 锁定的 OpenSPG 0.8 Neo4jSinkWriter 会 JSON 编码字符串属性；升级后须实际核对。
HOTLINE_OPENSPG_SCALAR_ENCODING=json
HOTLINE_NAMESPACE=Hotline
HOTLINE_NEO4J_URI=bolt://127.0.0.1:7687
HOTLINE_NEO4J_USER=neo4j
HOTLINE_NEO4J_PASSWORD=
HOTLINE_NEO4J_DATABASE=neo4j
HOTLINE_MAX_UPLOAD_MB=20
HOTLINE_MAX_TEXT_CHARS=500000
HOTLINE_MAX_CHUNKS=300
# OCR 在本地 CPU 执行；固定 RapidOCR 包内含模型，默认不需要另行下载。
HOTLINE_OCR_ENABLED=true
HOTLINE_OCR_MAX_PAGES=50
HOTLINE_OCR_RENDER_SIDE=2200
HOTLINE_OCR_THREADS=2
HOTLINE_OCR_REVIEW_THRESHOLD=0.85
# 离线自定义目录须包含部署说明列出的三个模型。留空时不要启用此项。
# HOTLINE_OCR_MODEL_DIR=data/models/ocr
HOTLINE_WORKER_ENABLED=true
# 进程内令牌桶限流（上传 / LLM 问答 / 反馈 POST）；单进程架构。
HOTLINE_RATE_LIMIT_ENABLED=true
HOTLINE_RATE_LIMIT_PER_MINUTE=60
HOTLINE_RATE_LIMIT_BURST=20
